# Configuración de Entorno de Desarrollo (Plantilla)
# Copia este archivo como .env y ajusta los valores locales.

# Aplicación
APP_ENV=development
APP_PORT=4261
SECRET_KEY=super_secret_jwt_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:4263,http://127.0.0.1:4263,http://172.30.23.141:4263

# Base de Datos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=separaaltoke_db
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
